# Copier ce fichier en `.env` et y mettre les vraies clés.
# `.env` est ignoré par Git — les secrets n'y sont jamais versionnés (D-016).

# --- Scan de carte (D-004, D-017) ---
# Fournisseur par défaut. Clé sur https://console.groq.com -> API Keys
GROQ_API_KEY=

# Fournisseur alternatif, pour le comparatif de précision d'extraction.
# Laisser vide si non utilisé.
ANTHROPIC_API_KEY=

# "groq" (défaut) ou "claude"
VISION_PROVIDER=groq

# --- Google Places : désactivé (D-005), laisser vide ---
GOOGLE_API_KEY=

# --- Collecteur de fiches et de photos de carte (D-028) ---
# Clé sur https://outscraper.com -> Profile -> API Keys
#
# ATTENTION : ce fournisseur NE BLOQUE PAS au-delà de son offre gratuite
# (500 éléments par mois) — il facture le dépassement. Les modules de collecte
# posent donc un plafond de sécurité à 450, et `--limit` borne chaque essai.
OUTSCRAPER_API_KEY=

# --- CORS (D-016) ---
# Nécessaire dès que les comptes utilisateurs sont actifs : un navigateur
# refuse un cookie de session si l'origine autorisée est "*" (valeur par
# défaut) en même temps que les requêtes credentialed (allow_credentials=True
# dans backend/main.py). En local, l'API (port 8000) et le web Vite (port
# 5173) sont deux origines différentes malgré le même "localhost".
ALLOWED_ORIGINS=http://localhost:5173

# --- Authentification (comptes utilisateurs) ---
# Durée de vie d'une session, en jours.
SESSION_TTL_DAYS=30
# "lax" en local ; "none" (+ SESSION_COOKIE_SECURE=true obligatoire) si web et
# API sont déployés sur des domaines différents en production.
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false
# Restaurants visibles par recherche pour un visiteur non connecté.
ANON_RESULTS_LIMIT=5
