# Copier ce fichier en `.env` et y mettre les vraies clés.
# `.env` est ignoré par Git — les secrets n'y sont jamais versionnés (D-016).

# --- Scan de carte (D-004, D-017) ---
# Fournisseur par défaut. Clé sur https://console.groq.com -> API Keys
GROQ_API_KEY=

# Fournisseur alternatif, pour le comparatif de précision d'extraction.
# Laisser vide si non utilisé.
ANTHROPIC_API_KEY=

# "groq" (défaut) ou "claude"
VISION_PROVIDER=groq

# --- Google Places : désactivé (D-005), laisser vide ---
GOOGLE_API_KEY=

# --- Collecteur de fiches et de photos de carte (D-028) ---
# Clé sur https://outscraper.com -> Profile -> API Keys
#
# ATTENTION : ce fournisseur NE BLOQUE PAS au-delà de son offre gratuite
# (500 éléments par mois) — il facture le dépassement. Les modules de collecte
# posent donc un plafond de sécurité à 450, et `--limit` borne chaque essai.
OUTSCRAPER_API_KEY=
